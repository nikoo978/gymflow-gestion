# GymFlow / Infytter Fitness - ejemplo de entorno portable.
# Copiar como .env y completar únicamente en el host/secret store.

# HTTP
PORT=3000
HOST=0.0.0.0
MAX_BODY_BYTES=1048576

# URL pública canónica usada por QStash para callbacks.
PUBLIC_APP_URL=https://gymflow.example.com

# Supabase público. La anon key puede exponerse al frontend; nunca usar service-role aquí.
VITE_SUPABASE_URL=https://ubfqwmhxkjtqdcfnsmwe.supabase.co
VITE_SUPABASE_ANON_KEY=example-public-anon-key
SUPABASE_URL=https://ubfqwmhxkjtqdcfnsmwe.supabase.co
SUPABASE_ANON_KEY=example-public-anon-key

# Upstash Redis
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-me
REDIS_STATE_KEY=gymflow

# QStash / callbacks internos
QSTASH_TOKEN=replace-me
NOTIFICATION_SECRET=replace-with-a-long-random-secret

# Web Push
VAPID_PUBLIC_KEY=replace-me
VAPID_PRIVATE_KEY=replace-me
VAPID_SUBJECT=mailto:admin@example.com
